# =============================================================================
# LenAI - Pricing Intelligence Platform
# Copy this file to .env and fill in your values before running docker compose
# =============================================================================

# --- App ---
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL (main relational store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lenai
POSTGRES_USER=lenai
POSTGRES_PASSWORD=change-me-strong-password

# Full DSN (auto-constructed from above in config.py - override here if needed)
# DATABASE_URL=postgresql+asyncpg://lenai:change-me@postgres:5432/lenai

# --- ChromaDB (vector store) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION_DOCUMENTS=lenai_documents

# --- Redis (job queue + session cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                         # uncomment if you set requirepass in redis.conf

# --- Ollama (self-hosted LLM + embeddings) ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b             # llama3.1:8b | mistral:7b | phi3:medium
OLLAMA_EMBED_MODEL=nomic-embed-text       # local embedding model - no external API

# Concurrency cap for Ollama (prevents OOM under parallel load)
OLLAMA_MAX_CONCURRENCY=2

# --- RAG Pipeline ---
CHUNK_SIZE=512                            # tokens per chunk
CHUNK_OVERLAP=50                          # token overlap between chunks
RAG_TOP_K_RETRIEVE=20                     # candidates from semantic search
RAG_TOP_K_RERANK=5                        # kept after cross-encoder rerank

# --- Memory Management ---
SESSION_WINDOW_TURNS=4                    # full turns kept in context
SESSION_SUMMARIZE_AFTER=8                 # summarize older turns after this count

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,csv,xlsx,xls

# --- CORS (adjust for your frontend domain in production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth (simple API key auth for demo; swap for JWT in production) ---
API_KEY=dev-api-key-change-in-production
